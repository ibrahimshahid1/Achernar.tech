# Achernar Web Frontend — committed development defaults.
# Vite auto-loads this file in dev mode (`vite` / `tauri dev`), so a fresh
# clone has working local URLs without any manual setup. Override locally with
# `.env` or `.env.local` (both git-ignored). See .env.example for docs.

VITE_DAEMON_URL=http://localhost:3030/api/v1
VITE_DAEMON_WS=ws://localhost:3030/ws/telemetry
VITE_CLOUD_API=http://localhost:8000/api
# VITE_HARDWARE_TRANSPORT=django
