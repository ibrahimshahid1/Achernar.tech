# Environment variables for development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/achernar
REDIS_URL=redis://localhost:6379/0
DJANGO_SETTINGS_MODULE=achernar_backend.settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Daemon configuration
ACHERNAR_HOST=127.0.0.1
ACHERNAR_PORT=3030
ACHERNAR_CLOUD_HTTP=http://127.0.0.1:8000
ACHERNAR_CLOUD_WS=ws://127.0.0.1:8000
ACHERNAR_RELAY_DEV_TOKEN=achernar-dev-token
ACHERNAR_HARDWARE_ID=achernar-local-daemon
ACHERNAR_DAEMON_ID=
ACHERNAR_DAEMON_BIN=
