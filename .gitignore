db.sqlite3
*.sqlite3
/local_settings.py
staticfiles/

# Node.js
node_modules/
package-lock.json
npm-debug.log
yarn-error.log
.npm

# Rust (achernar-daemon)
target/
Cargo.lock
# The daemon is a shipped application, not a reusable library. Pin its complete
# Rust dependency graph so Windows developer machines and CI test the same code.
!achernar-daemon/Cargo.lock
*.rs.bk

# Windows native dependency restore/bootstrap output.
.tools/vcpkg/
achernar-daemon/vcpkg_installed/

# SQLite offline store, wherever it lands.
# This used to be `achernar-daemon/achernar.db*` only, so a daemon started from
# the repo root wrote achernar.db / -wal / -shm beside the .gitignore and they
# were committed. A WAL file changes on every capture, so the working tree was
# permanently dirty and running the daemon produced a diff.
achernar.db
achernar.db-shm
achernar.db-wal
**/achernar.db
**/achernar.db-shm
**/achernar.db-wal
*.sqlite
*.sqlite3

# Capture archive: RAW/FITS bundles are large, immutable, and belong in the
# frame store, never in git.
frames/
**/frames/captures/
dslr-bench/

