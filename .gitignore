lib/
lib64/
# The bare lib/ pattern above targets Python build output, but it also matches
# the frontend's source dir achernar-frontend/src/lib (home of runtime.ts, the
# browser/desktop hardware-transport switch). Re-include it so fresh clones and
# CI builds are not missing the transport-switching wiring.
!achernar-frontend/src/lib/
!achernar-frontend/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt
.coverage
.pytest_cache/
.tox/
.env
.venv
env/
venv/
ENV/

