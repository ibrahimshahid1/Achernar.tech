{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "achernar-desktop",
  "version": "0.1.0",
  "identifier": "tech.achernar.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../achernar-frontend dev",
    "beforeBuildCommand": "pnpm --dir ../achernar-frontend build",
    "frontendDist": "../../achernar-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Achernar",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
